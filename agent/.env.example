# Copy to agent/.env and fill in. Leave Photon blank to run in simulator mode (web/phone.html).

# Photon 2.0 beta: https://app.beta.photon.codes → project → Settings / API keys
PHOTON_PROJECT_ID=pho_prj_xxxxxxxx
PHOTON_API_KEY=pho_sk_xxxxxxxx

# Optional: lets the agent answer free-form questions ("should I spray?") with Claude
ANTHROPIC_API_KEY=

PORT=8787
